{
  "name": "framenote-video-ai",
  "productName": "FrameNote",
  "version": "0.1.0",
  "description": "FrameNote Windows video AI summary workspace",
  "author": "FrameNote",
  "homepage": "https://github.com/lxc2006/FrameNote",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxc2006/FrameNote.git"
  },
  "private": true,
  "main": "out/main/index.cjs",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "desktop:dev": "electron-vite dev",
    "desktop:dev:shell": "electron-vite dev",
    "desktop:build": "electron-vite build",
    "desktop:pack": "pnpm desktop:build && electron-builder --dir --win --x64",
    "desktop:dist": "pnpm desktop:build && electron-builder --win nsis --x64 --publish never",
    "desktop:verify-delivery": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-delivery.ps1",
    "desktop:preview": "electron-vite preview",
    "desktop:smoke-ipc": "node scripts/desktop-ipc-smoke.mjs",
    "media:core:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-media-core.ps1",
    "test": "node --test tests/analysis-progress.test.mjs tests/markdown-content.test.mjs tests/model-usage.test.mjs tests/qwen-video-parser.test.mjs tests/video-recall.test.mjs",
    "lint": "eslint src electron.vite.config.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "openai": "^6.47.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.0.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.4",
    "lightningcss-win32-x64-msvc": "1.31.1",
    "typescript-eslint": "8.64.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
