# 阿里云百炼 / DashScope API Key。只放在服务端环境中，不要使用 NEXT_PUBLIC_ 前缀。
DASHSCOPE_API_KEY=

# 中国内地（北京）兼容接口。若模型属于专属 Workspace，请替换为控制台给出的地址：
# https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 同时理解长视频画面与声音；可按账号可用模型覆盖。
QWEN_VIDEO_MODEL=qwen3.5-omni-plus

# 模型请求超时，单位毫秒。
QWEN_REQUEST_TIMEOUT_MS=300000

# DeepSeek 视频追问接口。只放在服务端环境中。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_REQUEST_TIMEOUT_MS=300000

# SerpAPI Google 检索，仅在用户开启“联网搜索”且问题需要实时资料时调用。
SERPAPI_API_KEY=
SERPAPI_REQUEST_TIMEOUT_MS=15000

# 网页正文提取：普通 HTML 使用 Python 媒体服务中的 Trafilatura，PDF 使用 pypdf。
WEB_CONTENT_EXTRACT_TIMEOUT_MS=20000
FRAMENOTE_WEB_FETCH_TIMEOUT_SECONDS=12

# 可选。普通抓取判断页面必须运行 JavaScript 时，使用 Cloudflare Browser Rendering。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RUN_API_TOKEN=
CLOUDFLARE_BROWSER_RUN_TIMEOUT_MS=30000

# 媒体服务（处理本地、HTTPS 直链和 B站视频，独立运行 media_service/app.py）。线上必须使用 HTTPS。
BILIBILI_MEDIA_SERVICE_URL=http://127.0.0.1:8788

# 网站服务端与媒体服务共享的访问令牌。仅本机回环访问时可以留空；线上必须设置。
BILIBILI_MEDIA_SERVICE_TOKEN=

# 网站控制面调用媒体服务的单次超时（创建/查询/取消任务），单位毫秒。
BILIBILI_MEDIA_REQUEST_TIMEOUT_MS=15000

# 以下变量供 Python 媒体服务进程使用，不会由网站读取。
# 可选。仅当媒体下载需要代理时填写，例如 http://127.0.0.1:7890；留空表示直连。
FRAMENOTE_MEDIA_PROXY=

FRAMENOTE_FUNASR_MODEL=FunAudioLLM/Fun-ASR-Nano-2512
FRAMENOTE_FUNASR_HUB=ms
FRAMENOTE_FUNASR_VAD_MODEL=fsmn-vad
FRAMENOTE_FUNASR_PUNC_MODEL=ct-punc
FRAMENOTE_FUNASR_DEVICE=cpu
