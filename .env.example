# 桌面开发回退配置。普通用户应在应用设置中保存 Key，主进程会使用 Windows 加密。
# 阿里云百炼 / DashScope API Key。只由 Electron 主进程读取。
DASHSCOPE_API_KEY=

# 中国内地（北京）兼容接口。若模型属于专属 Workspace，请替换为控制台给出的地址：
# https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 同时理解长视频画面与声音；可按账号可用模型覆盖。
QWEN_VIDEO_MODEL=qwen3.5-omni-plus

# 模型请求超时，单位毫秒。
QWEN_REQUEST_TIMEOUT_MS=300000

# 在线字幕识别使用与视频总结相同的 DASHSCOPE_API_KEY。
QWEN_ASR_MODEL=qwen-audio-3.0-asr-flash
QWEN_ASR_REQUEST_TIMEOUT_MS=300000
# 可选。默认根据 DASHSCOPE_BASE_URL 推导 DashScope 原生多模态端点。
DASHSCOPE_ASR_ENDPOINT=

# 联网正文精排复用 DASHSCOPE_API_KEY。专属 Workspace 可填写控制台给出的完整地址；
# 也可以把上面的 DASHSCOPE_BASE_URL 设置为该 Workspace 的 compatible-mode/v1 地址自动推导。
DASHSCOPE_RERANK_ENDPOINT=
QWEN_RERANK_THRESHOLD=0.2
QWEN_RERANK_REQUEST_TIMEOUT_MS=60000
# 正文分片字符数，以及每个网页最终交给回答模型的近似 Token 上限。
WEB_RERANK_CHUNK_CHARACTERS=2000
WEB_RERANK_MAX_TOKENS_PER_SOURCE=20000

# DeepSeek 视频追问接口。只由 Electron 主进程读取。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_REQUEST_TIMEOUT_MS=300000

# SerpAPI Google 检索，仅在用户开启“联网搜索”且问题需要实时资料时调用。
SERPAPI_API_KEY=
SERPAPI_REQUEST_TIMEOUT_MS=15000

# 网页正文提取：普通 HTML 使用 Python 媒体服务中的 Trafilatura，PDF 使用 pypdf。
WEB_CONTENT_EXTRACT_TIMEOUT_MS=20000
FRAMENOTE_WEB_FETCH_TIMEOUT_SECONDS=12

# 可选。联网检索遇到必须执行 JavaScript 的页面时，使用 Cloudflare Browser Rendering API。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RUN_API_TOKEN=
CLOUDFLARE_BROWSER_RUN_TIMEOUT_MS=30000

# Electron 启动 sidecar 后会自动覆盖以下两项；通常不需要手动填写。
BILIBILI_MEDIA_SERVICE_URL=http://127.0.0.1:8788

# 桌面主进程与媒体 sidecar 的本机会话令牌。
BILIBILI_MEDIA_SERVICE_TOKEN=

# 主进程调用媒体服务的单次超时，单位毫秒。
BILIBILI_MEDIA_REQUEST_TIMEOUT_MS=15000

# 以下变量供 Python 媒体服务进程使用，不会由 Renderer 读取。
# 监听端口；Electron 会按端口占用情况为它启动的 sidecar 自动覆盖。
FRAMENOTE_MEDIA_PORT=8788

# 可选。仅当媒体下载需要代理时填写，例如 http://127.0.0.1:7890；留空表示直连。
FRAMENOTE_MEDIA_PROXY=
